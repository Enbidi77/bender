{
  "name": "blender-elt-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Blender-inspired 3D Desktop Application Monorepo",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @blender-elt/desktop test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules packages/*/dist packages/*/node_modules apps/*/dist apps/*/out",
    "package": "pnpm --filter @blender-elt/desktop package"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
